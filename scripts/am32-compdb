#!/usr/bin/env python3
"""Write compile_commands.json for an AM32 tree so clangd gets real flags.

AM32 builds each target with one gcc call over every source, and bear isn't
installed, so this reads `make -n` and splits that call into one entry per .c.

usage: am32-compdb [AM32_DIR] [TARGET]    (defaults: ., FOXEER_F421)
"""
import glob, json, os, shlex, subprocess, sys

root = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else '.')
target = sys.argv[2] if len(sys.argv) > 2 else 'FOXEER_F421'

out = subprocess.run(['make', '-B', '-n', target], cwd=root,
                     capture_output=True, text=True, check=True).stdout
line = next(l for l in out.splitlines() if 'arm-none-eabi-gcc ' in l)
args = shlex.split(line)

# The Makefile points at a repo-local toolchain under tools/ that may not be
# installed; use whichever arm-none-eabi-gcc exists so clangd can query it.
gcc = (glob.glob('/opt/gcc-arm-none-eabi-*/bin/arm-none-eabi-gcc')
       + [os.path.join(root, args[0])])[0]
srcs = [a for a in args[1:] if a.endswith('.c')]
flags = [a for a in args[1:] if a.startswith(('-D', '-I', '-m', '-f', '--specs', '-specs'))]
# gcc defaults to soft float; clang assumes a cortex-m4 has its FPU and then
# trips CMSIS's "FPU instructions for a device without an FPU" #error.
if not any(a.startswith('-mfloat-abi') for a in flags):
    flags.append('-mfloat-abi=soft')

db = [{'directory': root, 'file': s, 'arguments': [gcc, *flags, '-c', s]} for s in srcs]
with open(os.path.join(root, 'compile_commands.json'), 'w') as f:
    json.dump(db, f, indent=1)
print(f'{len(db)} entries for {target} -> {root}/compile_commands.json')
